# Guard against accidentally committing secrets or machine-local state.

# Auth tokens / credentials
hosts.yml
oauth.json
*.token
*_token
.netrc

# History & caches
.zsh_history
.python_history
__pycache__/
.lesshst
.viminfo
.zcompdump*

# Editor swap/undo/backup
*.sw[a-p]
*~
*.bak

# macOS
.DS_Store

# install.sh backups
*.bak
