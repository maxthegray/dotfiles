{
  "name": "Dogrun",
  "mode": "dark",
  "palette": {
    "background": "#262626",
    "surface": "#222433",
    "selection": "#2A2C3F",
    "foreground": "#AFAFD7",
    "muted": "#757AA5",
    "border": "#363859",
    "accent": "#8787D7",
    "success": "#87AF87",
    "error": "#DC6F79",
    "warning": "#AFAF87",
    "info": "#8787FF",
    "purple": "#AF5FAF",
    "cyan": "#5FD7AF",
    "orange": "#D7875F",
    "diff_added": "#1C394B",
    "diff_removed": "#5E3E5E",
    "diff_added_dim": "#263B43",
    "diff_removed_dim": "#453344",
    "diff_added_word": "#28795C",
    "diff_removed_word": "#754A68",
    "message_bg": "#32364C"
  },
  "iterm": {
    "fg": "$foreground",
    "bg": "$background",
    "bold": "$accent",
    "link": "$accent",
    "selbg": "$selection",
    "selfg": "$foreground",
    "curbg": "$accent",
    "curfg": "$background",
    "underline": "$info",
    "tab": "$accent",
    "black": "#262626",
    "red": "#AF5F5F",
    "green": "#87AF87",
    "yellow": "#AFAF5F",
    "blue": "#8787D7",
    "magenta": "#AF5FAF",
    "cyan": "#5FD7AF",
    "white": "#AFAFD7",
    "br_black": "#5F5F87",
    "br_red": "#D75F5F",
    "br_green": "#87D7AF",
    "br_yellow": "#AFAF87",
    "br_blue": "#8787FF",
    "br_magenta": "#D75FD7",
    "br_cyan": "#5FD7D7",
    "br_white": "#D7D7FF"
  },
  "nvim": {
    "colorscheme": "dogrun",
    "lightline": "dogrun",
    "transparent": true,
    "globals": {}
  },
  "claude": {
    "base": "dark",
    "overrides": {
      "claude": "$accent",
      "text": "$foreground",
      "inverseText": "$background",
      "inactive": "$muted",
      "subtle": "$border",
      "suggestion": "$info",
      "permission": "$warning",
      "remember": "$purple",
      "success": "$success",
      "error": "$error",
      "warning": "$warning",
      "merged": "$purple",
      "promptBorder": "$accent",
      "planMode": "$info",
      "autoAccept": "$success",
      "bashBorder": "$orange",
      "ide": "$purple",
      "diffAdded": "$diff_added",
      "diffRemoved": "$diff_removed",
      "diffAddedDimmed": "$diff_added_dim",
      "diffRemovedDimmed": "$diff_removed_dim",
      "diffAddedWord": "$diff_added_word",
      "diffRemovedWord": "$diff_removed_word",
      "userMessageBackground": "$message_bg"
    }
  }
}
