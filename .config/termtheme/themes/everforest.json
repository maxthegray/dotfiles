{
  "name": "Everforest Dark Dogbg",
  "mode": "dark",
  "palette": {
    "background": "#262626",
    "surface": "#252525",
    "selection": "#4C3743",
    "foreground": "#D3C6AA",
    "muted": "#859289",
    "border": "#3D3D3D",
    "accent": "#A7C080",
    "success": "#A7C080",
    "error": "#E67E80",
    "warning": "#DBBC7F",
    "info": "#7FBBB3",
    "purple": "#D699B6",
    "cyan": "#83C092",
    "orange": "#E69875",
    "diff_added": "#2D4F32",
    "diff_removed": "#543A48",
    "diff_added_dim": "#293B2E",
    "diff_removed_dim": "#3F3038",
    "diff_added_word": "#3F6845",
    "diff_removed_word": "#6C4655",
    "message_bg": "#323D43"
  },
  "iterm": {
    "fg": "$foreground",
    "bg": "$background",
    "bold": "$warning",
    "link": "$info",
    "selbg": "$selection",
    "selfg": "$foreground",
    "curbg": "$orange",
    "curfg": "$selection",
    "underline": "$info",
    "tab": "$accent",
    "black": "#7A8478",
    "red": "#E67E80",
    "green": "#A7C080",
    "yellow": "#DBBC7F",
    "blue": "#7FBBB3",
    "magenta": "#D699B6",
    "cyan": "#83C092",
    "white": "#F2EFDF",
    "br_black": "#A6B0A0",
    "br_red": "#F85552",
    "br_green": "#8DA101",
    "br_yellow": "#DFA000",
    "br_blue": "#3A94C5",
    "br_magenta": "#DF69BA",
    "br_cyan": "#35A77C",
    "br_white": "#FFFBEF"
  },
  "nvim": {
    "colorscheme": "everforest",
    "lightline": "everforest",
    "transparent": true,
    "globals": {
      "everforest_background": "hard",
      "everforest_better_performance": 1,
      "everforest_enable_italic": 1,
      "everforest_transparent_background": 1
    }
  },
  "claude": {
    "base": "dark",
    "overrides": {
      "claude": "$accent",
      "text": "$foreground",
      "inverseText": "$background",
      "inactive": "$muted",
      "subtle": "$border",
      "suggestion": "$info",
      "permission": "$warning",
      "remember": "$purple",
      "success": "$success",
      "error": "$error",
      "warning": "$warning",
      "merged": "$purple",
      "promptBorder": "$accent",
      "planMode": "$info",
      "autoAccept": "$success",
      "bashBorder": "$orange",
      "ide": "$purple",
      "diffAdded": "$diff_added",
      "diffRemoved": "$diff_removed",
      "diffAddedDimmed": "$diff_added_dim",
      "diffRemovedDimmed": "$diff_removed_dim",
      "diffAddedWord": "$diff_added_word",
      "diffRemovedWord": "$diff_removed_word",
      "userMessageBackground": "$message_bg"
    }
  }
}
