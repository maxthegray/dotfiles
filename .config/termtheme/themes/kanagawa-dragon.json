{
  "name": "Kanagawa Dragon",
  "mode": "dark",
  "palette": {
    "background": "#181616",
    "surface": "#1D1C19",
    "selection": "#282727",
    "foreground": "#C5C9C5",
    "muted": "#737C73",
    "border": "#393836",
    "accent": "#C8C093",
    "success": "#87A987",
    "error": "#C4746E",
    "warning": "#C4B28A",
    "info": "#8BA4B0",
    "purple": "#A292A3",
    "cyan": "#8EA4A2",
    "orange": "#B6927B",
    "diff_added": "#26332A",
    "diff_removed": "#3A2727",
    "diff_added_dim": "#20271F",
    "diff_removed_dim": "#2D2221",
    "diff_added_word": "#35483A",
    "diff_removed_word": "#543431",
    "message_bg": "#282727"
  },
  "iterm": {
    "fg": "#C5C9C5",
    "bg": "#181616",
    "bold": "#C5C9C5",
    "link": "#8BA4B0",
    "selbg": "#C5C9C5",
    "selfg": "#181616",
    "curbg": "#C8C093",
    "curfg": "#181616",
    "underline": "#8BA4B0",
    "tab": "$accent",
    "black": "#0D0C0C",
    "red": "#C4746E",
    "green": "#8A9A7B",
    "yellow": "#C4B28A",
    "blue": "#8BA4B0",
    "magenta": "#A292A3",
    "cyan": "#8EA4A2",
    "white": "#C8C093",
    "br_black": "#A6A69C",
    "br_red": "#E46876",
    "br_green": "#87A987",
    "br_yellow": "#E6C384",
    "br_blue": "#7FB4CA",
    "br_magenta": "#938AA9",
    "br_cyan": "#7AA89F",
    "br_white": "#C5C9C5"
  },
  "nvim": {
    "colorscheme": "kanagawa-dragon",
    "lightline": "wombat",
    "vim_fallback": "everforest",
    "vim_fallback_lightline": "everforest",
    "transparent": true,
    "globals": {
      "everforest_background": "hard",
      "everforest_better_performance": 1,
      "everforest_enable_italic": 1,
      "everforest_transparent_background": 1
    }
  },
  "claude": {
    "base": "dark",
    "overrides": {
      "claude": "$accent",
      "text": "$foreground",
      "inverseText": "$background",
      "inactive": "$muted",
      "subtle": "$border",
      "suggestion": "$info",
      "permission": "$warning",
      "remember": "$purple",
      "success": "$success",
      "error": "$error",
      "warning": "$warning",
      "merged": "$purple",
      "promptBorder": "$accent",
      "planMode": "$info",
      "autoAccept": "$success",
      "bashBorder": "$orange",
      "ide": "$purple",
      "diffAdded": "$diff_added",
      "diffRemoved": "$diff_removed",
      "diffAddedDimmed": "$diff_added_dim",
      "diffRemovedDimmed": "$diff_removed_dim",
      "diffAddedWord": "$diff_added_word",
      "diffRemovedWord": "$diff_removed_word",
      "userMessageBackground": "$message_bg"
    }
  }
}
