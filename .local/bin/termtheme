#!/usr/bin/env python3
"""Switch the coordinated terminal theme from one versioned manifest."""

from __future__ import annotations

import argparse
import json
import os
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Any


REPO_ROOT = Path(__file__).resolve().parents[2]
THEME_DIR = REPO_ROOT / ".config" / "termtheme" / "themes"
HOME = Path.home()
CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", HOME / ".cache")) / "termtheme"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME", HOME / ".local" / "state")) / "termtheme"
CURRENT_FILE = STATE_DIR / "current.json"

GENERATED_PATHS = {
    "tmux": CACHE_DIR / "tmux.conf",
    "starship": CACHE_DIR / "starship.toml",
    "zsh": CACHE_DIR / "zsh.zsh",
    "nvim": CACHE_DIR / "nvim.vim",
    "codex": HOME / ".codex" / "themes" / "termtheme.tmTheme",
}

PALETTE_KEYS = {
    "background",
    "surface",
    "selection",
    "foreground",
    "muted",
    "border",
    "accent",
    "success",
    "error",
    "warning",
    "info",
    "purple",
    "cyan",
    "orange",
}

ITERM_KEYS = (
    "fg",
    "bg",
    "bold",
    "link",
    "selbg",
    "selfg",
    "curbg",
    "curfg",
    "underline",
    "tab",
    "black",
    "red",
    "green",
    "yellow",
    "blue",
    "magenta",
    "cyan",
    "white",
    "br_black",
    "br_red",
    "br_green",
    "br_yellow",
    "br_blue",
    "br_magenta",
    "br_cyan",
    "br_white",
)

HEX_COLOR = re.compile(r"^#[0-9a-fA-F]{6}$")


class ThemeError(RuntimeError):
    pass


def theme_files() -> list[Path]:
    return sorted(THEME_DIR.glob("*.json"))


def load_theme(slug: str) -> dict[str, Any]:
    path = THEME_DIR / f"{slug}.json"
    if not path.is_file():
        choices = ", ".join(p.stem for p in theme_files()) or "none installed"
        raise ThemeError(f"unknown theme {slug!r}; available: {choices}")
    try:
        data = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as exc:
        raise ThemeError(f"cannot read {path}: {exc}") from exc
    validate_theme(data, path)
    data["slug"] = slug
    return data


def resolve_color(theme: dict[str, Any], value: str) -> str:
    if value.startswith("$"):
        key = value[1:]
        try:
            value = theme["palette"][key]
        except KeyError as exc:
            raise ThemeError(f"undefined palette reference {value!r}") from exc
    if not isinstance(value, str) or not HEX_COLOR.fullmatch(value):
        raise ThemeError(f"invalid color {value!r}; expected #RRGGBB")
    return value.upper()


def validate_theme(theme: dict[str, Any], path: Path) -> None:
    for key in ("name", "mode", "palette", "iterm", "nvim", "claude"):
        if key not in theme:
            raise ThemeError(f"{path}: missing {key!r}")
    if theme["mode"] not in ("dark", "light"):
        raise ThemeError(f"{path}: mode must be 'dark' or 'light'")
    missing = sorted(PALETTE_KEYS - set(theme["palette"]))
    if missing:
        raise ThemeError(f"{path}: missing palette colors: {', '.join(missing)}")
    for value in theme["palette"].values():
        resolve_color(theme, value)
    missing = sorted(set(ITERM_KEYS) - set(theme["iterm"]))
    if missing:
        raise ThemeError(f"{path}: missing iTerm colors: {', '.join(missing)}")
    for key in ITERM_KEYS:
        resolve_color(theme, theme["iterm"][key])
    for value in theme["claude"].get("overrides", {}).values():
        resolve_color(theme, value)
    if not re.fullmatch(r"[A-Za-z0-9_-]+", theme["nvim"].get("colorscheme", "")):
        raise ThemeError(f"{path}: invalid Neovim colorscheme")


def q(value: str) -> str:
    return value.replace("'", "''")


def vim_value(value: Any) -> str:
    if isinstance(value, bool):
        return "1" if value else "0"
    if isinstance(value, (int, float)):
        return str(value)
    return f"'{q(str(value))}'"


def render_tmux(theme: dict[str, Any]) -> str:
    palette = theme["palette"]
    mappings = {
        "name": theme["slug"],
        "bg": palette["surface"],
        "fg": palette["foreground"],
        "muted": palette["muted"],
        "border": palette["border"],
        "accent": palette["accent"],
        "error": palette["error"],
        "warning": palette["warning"],
        "info": palette["info"],
    }
    lines = ["# Generated by termtheme. Do not edit."]
    for key, value in mappings.items():
        if key != "name":
            value = resolve_color(theme, value)
        lines.append(f"set -g @termtheme_{key} '{value}'")
    bg = resolve_color(theme, palette["surface"])
    fg = resolve_color(theme, palette["foreground"])
    border = resolve_color(theme, palette["border"])
    accent = resolve_color(theme, palette["accent"])
    lines.extend(
        [
            f"set -g status-style 'bg={bg},fg={fg}'",
            f"set -g pane-border-style 'fg={border}'",
            f"set -g pane-active-border-style 'fg={accent}'",
            f"set -g message-style 'bg={bg},fg={fg}'",
        ]
    )
    return "\n".join(lines) + "\n"


def render_starship(theme: dict[str, Any]) -> str:
    p = {key: resolve_color(theme, value) for key, value in theme["palette"].items()}
    return f'''# Generated by termtheme. Do not edit.
add_newline = false

format = "$directory$character"

[directory]
style = "fg:{p['muted']}"
truncation_length = 3
truncate_to_repo = false

[git_branch]
symbol = "⎇ "
style = "fg:{p['accent']}"
format = " [$symbol$branch]($style)"

[git_status]
style = "fg:{p['error']}"
format = "[$all_status$ahead_behind]($style)"

[character]
success_symbol = "[λ](fg:{p['accent']})"
error_symbol = "[λ](fg:{p['error']})"

[package]
disabled = true
[nodejs]
disabled = true
[python]
disabled = true
[java]
disabled = true
[gradle]
disabled = true
[cmd_duration]
disabled = true
'''


def render_zsh(theme: dict[str, Any]) -> str:
    p = {key: resolve_color(theme, value) for key, value in theme["palette"].items()}
    return f'''# Generated by termtheme. Do not edit.
typeset -g TERM_THEME={theme['slug']!r}
ZSH_HIGHLIGHT_STYLES[command]='fg={p['info']}'
ZSH_HIGHLIGHT_STYLES[builtin]='fg={p['info']}'
ZSH_HIGHLIGHT_STYLES[alias]='fg={p['info']}'
ZSH_HIGHLIGHT_STYLES[function]='fg={p['info']}'
'''


def render_nvim(theme: dict[str, Any]) -> str:
    nvim = theme["nvim"]
    lines = [
        '" Generated by termtheme. Do not edit.',
        f"let g:termtheme_name = '{q(theme['slug'])}'",
        f"let g:termtheme_colorscheme = '{q(nvim['colorscheme'])}'",
        f"let g:termtheme_lightline = '{q(nvim.get('lightline', nvim['colorscheme']))}'",
        f"set background={theme['mode']}",
    ]
    if nvim.get("vim_fallback"):
        lines.extend(
            [
                "if !has('nvim')",
                f"  let g:termtheme_colorscheme = '{q(nvim['vim_fallback'])}'",
                f"  let g:termtheme_lightline = '{q(nvim.get('vim_fallback_lightline', nvim['vim_fallback']))}'",
                "endif",
            ]
        )
    for name, value in nvim.get("globals", {}).items():
        if not re.fullmatch(r"[A-Za-z0-9_]+", name):
            raise ThemeError(f"invalid Neovim global name {name!r}")
        lines.append(f"let g:{name} = {vim_value(value)}")
    lines.extend(
        [
            "execute 'colorscheme ' . g:termtheme_colorscheme",
            "if get(g:, 'termtheme_transparent', 0)",
            "  highlight Normal guibg=NONE ctermbg=NONE",
            "  highlight NormalNC guibg=NONE ctermbg=NONE",
            "endif",
            "if exists('g:lightline')",
            "  let g:lightline.colorscheme = g:termtheme_lightline",
            "  if exists('*lightline#init')",
            "    call lightline#init()",
            "    call lightline#colorscheme()",
            "    call lightline#update()",
            "  endif",
            "endif",
        ]
    )
    transparent = 1 if nvim.get("transparent", False) else 0
    lines.insert(4, f"let g:termtheme_transparent = {transparent}")
    return "\n".join(lines) + "\n"


def render_codex(theme: dict[str, Any]) -> bytes:
    p = {key: resolve_color(theme, value) for key, value in theme["palette"].items()}
    settings = [
        {
            "settings": {
                "background": p["background"],
                "caret": p["accent"],
                "foreground": p["foreground"],
                "invisibles": p["border"],
                "lineHighlight": p["surface"],
                "selection": p["selection"],
            }
        },
        {"name": "Comments", "scope": "comment, punctuation.definition.comment", "settings": {"foreground": p["muted"], "fontStyle": "italic"}},
        {"name": "Strings", "scope": "string, constant.other.symbol", "settings": {"foreground": p["success"]}},
        {"name": "Numbers", "scope": "constant.numeric, constant.language", "settings": {"foreground": p["purple"]}},
        {"name": "Keywords", "scope": "keyword, storage.type, storage.modifier", "settings": {"foreground": p["error"]}},
        {"name": "Functions", "scope": "entity.name.function, support.function", "settings": {"foreground": p["accent"]}},
        {"name": "Types", "scope": "entity.name.type, entity.name.class, support.type", "settings": {"foreground": p["warning"]}},
        {"name": "Variables", "scope": "variable, meta.definition.variable", "settings": {"foreground": p["foreground"]}},
        {"name": "Operators", "scope": "keyword.operator, punctuation", "settings": {"foreground": p["info"]}},
        {"name": "Invalid", "scope": "invalid", "settings": {"foreground": p["background"], "background": p["error"]}},
    ]
    data = {"name": f"Termtheme: {theme['name']}", "settings": settings}
    return plistlib.dumps(data, fmt=plistlib.FMT_XML, sort_keys=False)


def rendered_targets(theme: dict[str, Any]) -> dict[Path, bytes]:
    text_targets = {
        GENERATED_PATHS["tmux"]: render_tmux(theme),
        GENERATED_PATHS["starship"]: render_starship(theme),
        GENERATED_PATHS["zsh"]: render_zsh(theme),
        GENERATED_PATHS["nvim"]: render_nvim(theme),
    }
    result = {path: text.encode() for path, text in text_targets.items()}
    result[GENERATED_PATHS["codex"]] = render_codex(theme)
    return result


def atomic_write(path: Path, content: bytes, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    old_mode = path.stat().st_mode & 0o777 if path.exists() else mode
    fd, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, old_mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def backup_once(source: Path, name: str) -> None:
    if not source.is_file():
        return
    destination = STATE_DIR / "backups" / "pre-managed" / name
    if destination.exists():
        return
    destination.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(source, destination)


def configure_codex() -> bool:
    path = HOME / ".codex" / "config.toml"
    if not path.is_file():
        return False
    text = path.read_text()
    lines = text.splitlines(keepends=True)
    section_start = None
    section_end = len(lines)
    for index, line in enumerate(lines):
        match = re.match(r"^\s*\[([^]]+)]\s*(?:#.*)?$", line)
        if not match:
            continue
        if section_start is not None:
            section_end = index
            break
        if match.group(1).strip() == "tui":
            section_start = index
    replacement = 'theme = "termtheme"\n'
    changed = False
    if section_start is None:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        if lines and lines[-1].strip():
            lines.append("\n")
        lines.extend(["[tui]\n", replacement])
        changed = True
    else:
        theme_index = None
        for index in range(section_start + 1, section_end):
            if re.match(r"^\s*theme\s*=", lines[index]):
                theme_index = index
                break
        if theme_index is None:
            lines.insert(section_end, replacement)
            changed = True
        elif lines[theme_index] != replacement:
            lines[theme_index] = replacement
            changed = True
    if changed:
        backup_once(path, "codex-config.toml")
        atomic_write(path, "".join(lines).encode())
    return changed


def apply_iterm(theme: dict[str, Any]) -> str | None:
    utility = shutil.which("it2setcolor")
    if not utility:
        return "iTerm2: it2setcolor is not on PATH"
    if not sys.stdout.isatty():
        return "iTerm2: skipped because stdout is not a terminal"
    args = [utility]
    for key in ITERM_KEYS:
        args.extend((key, resolve_color(theme, theme["iterm"][key]).lstrip("#")))
    result = subprocess.run(args, check=False)
    if result.returncode:
        return f"iTerm2: it2setcolor exited {result.returncode}"
    return None


def apply_tmux() -> str | None:
    utility = shutil.which("tmux")
    if not utility:
        return "tmux: executable not found"
    probe = subprocess.run([utility, "list-sessions"], capture_output=True, text=True)
    if probe.returncode:
        return None
    result = subprocess.run(
        [utility, "source-file", str(HOME / ".tmux.conf")],
        capture_output=True,
        text=True,
    )
    if result.returncode:
        return f"tmux: {result.stderr.strip() or f'exited {result.returncode}'}"
    return None


def apply_nvim() -> str | None:
    pgrep = shutil.which("pgrep")
    if not pgrep:
        return "Neovim: pgrep not found; running editors were not signalled"
    result = subprocess.run(
        [pgrep, "-u", str(os.getuid()), "-x", "nvim"],
        capture_output=True,
        text=True,
    )
    if result.returncode not in (0, 1):
        return f"Neovim: pgrep exited {result.returncode}"
    failures = []
    for raw_pid in result.stdout.split():
        try:
            os.kill(int(raw_pid), signal.SIGUSR1)
        except (OSError, ValueError):
            failures.append(raw_pid)
    if failures:
        return f"Neovim: could not signal PID(s) {', '.join(failures)}"
    return None


def use_theme(slug: str, dry_run: bool, no_live: bool) -> int:
    theme = load_theme(slug)
    targets = rendered_targets(theme)
    if dry_run:
        print(f"Would activate {slug} ({theme['name']}):")
        for path in targets:
            print(f"  {path}")
        print(f"  {HOME / '.codex' / 'config.toml'} (tui.theme, if needed)")
        return 0

    for path, content in targets.items():
        atomic_write(path, content)
    codex_changed = configure_codex()
    state = {"slug": slug, "name": theme["name"]}
    atomic_write(CURRENT_FILE, (json.dumps(state, indent=2) + "\n").encode())

    warnings = []
    if not no_live:
        for warning in (apply_iterm(theme), apply_tmux(), apply_nvim()):
            if warning:
                warnings.append(warning)

    print(f"Activated {slug} ({theme['name']}).")
    if codex_changed:
        print("Codex is now pinned to the managed syntax theme.")
    if no_live:
        print("Live application skipped; generated files and preferences were updated.")
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    return 0


def current_slug() -> str | None:
    try:
        return json.loads(CURRENT_FILE.read_text()).get("slug")
    except (OSError, json.JSONDecodeError):
        return None


def list_themes() -> int:
    current = current_slug()
    for path in theme_files():
        try:
            theme = load_theme(path.stem)
            marker = "*" if path.stem == current else " "
            print(f"{marker} {path.stem:<20} {theme['name']}")
        except ThemeError as exc:
            print(f"! {path.stem:<20} {exc}")
    return 0


def doctor() -> int:
    failures = 0
    for path in theme_files():
        try:
            theme = load_theme(path.stem)
            scheme = theme["nvim"]["colorscheme"]
            installed = any((HOME / ".vim" / "plugged").glob(f"*/colors/{scheme}.vim"))
            status = "ok" if installed else "missing Neovim colorscheme"
            print(f"{path.stem}: {status}")
            failures += 0 if installed else 1
        except ThemeError as exc:
            print(f"{path.stem}: {exc}")
            failures += 1
    for command in ("it2setcolor", "tmux", "nvim", "starship"):
        print(f"{command}: {shutil.which(command) or 'not found'}")
    print(f"current: {current_slug() or 'not initialized'}")
    return 1 if failures else 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="Switch the coordinated terminal theme")
    subparsers = parser.add_subparsers(dest="command")
    use = subparsers.add_parser("use", help="activate a theme")
    use.add_argument("theme")
    use.add_argument("--dry-run", action="store_true")
    use.add_argument("--no-live", action="store_true")
    subparsers.add_parser("list", help="list available themes")
    subparsers.add_parser("current", help="print the active theme")
    subparsers.add_parser("doctor", help="validate themes and dependencies")
    return parser


def main(argv: list[str]) -> int:
    commands = {"use", "list", "current", "doctor", "-h", "--help"}
    if argv and argv[0] not in commands:
        argv = ["use", *argv]
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "use":
            return use_theme(args.theme, args.dry_run, args.no_live)
        if args.command == "list" or args.command is None:
            return list_themes()
        if args.command == "current":
            current = current_slug()
            if current:
                print(current)
                return 0
            print("no theme has been activated", file=sys.stderr)
            return 1
        if args.command == "doctor":
            return doctor()
    except ThemeError as exc:
        print(f"termtheme: {exc}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
