#!/usr/bin/env bash
# tmux-fresh FILE MAXAGE
# Print FILE's contents only if it was modified within MAXAGE seconds, else
# nothing. Lets the tmux bar drop stale per-pane status files left behind when
# a pane is held by a long-running program (so _tmux_precmd never clears them).
f="$1"; max="$2"
[ -f "$f" ] || exit 0
m="$(stat -f %m "$f" 2>/dev/null)" || exit 0
[ $(( $(date +%s) - m )) -le "$max" ] && cat "$f"
exit 0
